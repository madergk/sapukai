# 🎨 Figma Console MCP Configuration
# Copy this file to .env.mcp and update with your values

# ========== REQUIRED ==========

# Your Figma file key (extract from URL)
# Example URL: https://www.figma.com/design/abc123xyz/Design%20System
# FILE_KEY = abc123xyz
FIGMA_FILE_KEY=your_figma_file_key_here

# ========== OPTIONAL ==========

# Method to use for syncing tokens
# Options: mcp (Console MCP), rest (REST API), manual (Copy/paste)
# Default: manual
SYNC_METHOD=manual

# Enable automatic token sync on file changes
# When true, tokens are fetched every time you push to a certain branch
ENABLE_AUTO_SYNC=false

# Slack notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord notifications (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# ========== ADVANCED ==========

# Cache tokens locally to avoid repeated API calls
# Useful if using REST API method
CACHE_TOKENS=true

# Log level for debugging
# Options: error, warn, info, debug
LOG_LEVEL=info

# Validate tokens before committing
VALIDATE_BEFORE_COMMIT=true

# Generate token documentation
GENERATE_DOCS=true

# Include component variants in token report
INCLUDE_COMPONENTS=true
