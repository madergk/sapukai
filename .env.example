# Figma API Configuration
FIGMA_ACCESS_TOKEN=your_figma_personal_access_token_here
FIGMA_FILE_KEY=your_figma_file_key_here

# Optional: Figma file URL
# Get the file key from: https://www.figma.com/design/{FILE_KEY}/...
FIGMA_FILE_URL=

# Notification Webhooks (optional)
# For Slack: Create an incoming webhook at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# For Discord: Create a webhook in Channel Settings > Integrations
DISCORD_WEBHOOK_URL=
